# iOS 16.1+ 필수 — ActivityKit (Live Activity) 사용
platform :ios, '16.1'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || Gem::Version.new(current) < Gem::Version.new('16.1')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.1'
      end
    end

    # flutter_app_group_directory 1.1.0 / live_activities 2.4.3 podspec 의 s.source_files
    # 와일드카드가 PrivacyInfo.xcprivacy 를 Compile Sources 로 포함시켜 빌드 실패 (no rule to process file of type 'text.xml')
    # resource_bundles 선언이 주석 처리돼 있어 Xcode 가 컴파일하려다 깨짐 → Compile Sources 에서 제거.
    if ['live_activities', 'flutter_app_group_directory'].include?(target.name)
      target.source_build_phase.files.dup.each do |bf|
        ref = bf.file_ref
        if ref && ref.path && ref.path.end_with?('PrivacyInfo.xcprivacy')
          target.source_build_phase.remove_build_file(bf)
        end
      end
    end

    # 업스트림이 미유지보수이거나 수정이 어려운 서드파티 타겟의 경고 억제.
    # - home_widget 0.9.1: Sendable capture, 미사용 immutable, String?→Any coercion 등
    #   (0.7.0 → 0.9.1 업그레이드로도 경고는 그대로 — CHANGELOG에 수정 없음)
    # - live_activities 2.4.3: Swift 6 Sendable / @Sendable capture / exhaustive switch 경고
    # - native_liquid_glass 0.2.6: iOS 15+ deprecated UIButton insets, weak ref 즉시 해제 등
    # - SVGKit 3.0.0 (native_liquid_glass 의존): DDASLLogger deprecated, C prototype, umbrella header
    #
    # 주의: GCC_WARN_* 빌드 설정은 CocoaPods / podspec 이 명령줄 -W 플래그를 주입하면 무력화되므로,
    # WARNING_CFLAGS 로 -Wno-* 를 직접 주입해야 안정적으로 억제된다. Swift 타겟이 C 모듈
    # (SVGKit modulemap 등) 을 임포트할 때 발생하는 Clang 경고는 OTHER_SWIFT_FLAGS -Xcc 로 전달.
    if %w[home_widget live_activities native_liquid_glass SVGKit].include?(target.name)
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        config.build_settings['WARNING_CFLAGS'] = '$(inherited) -Wno-deprecated-declarations -Wno-strict-prototypes -Wno-incomplete-umbrella'
        config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -Xcc -Wno-incomplete-umbrella -Xcc -Wno-deprecated-declarations'
      end
    end
  end
end
